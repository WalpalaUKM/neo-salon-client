// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User{
  Id String @id @default(uuid())
  email String @unique
  phone String ? @unique
  firstName String
  lastName String
  password String
  role String @default("CUSTOMER")
  status String @default("ACTIVE") //ACTIVE, BANNED, SUSPENDED
  createdAt DateTime @default(now())
  lastLogin DateTime ? @db.Timestamptz(3)
  privileges String[] @default([])//privileges": ["users:add","users:edit","users:read"]
  proflePicture String @default("/image/default-profile.png")
  //emailVerified Boolean @default(false)
  //phoneVerified Boolean @default(false)
}  