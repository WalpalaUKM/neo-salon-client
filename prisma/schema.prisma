generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Student{
  id Int @id @default(autoincrement())
  name String
  city String
}

model Teacher{
  id Int @id @default(autoincrement())
  name String
  subject String

 
}

